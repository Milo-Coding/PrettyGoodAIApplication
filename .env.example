# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Pipeline providers
# Deepgram for streaming STT, OpenAI for LLM and TTS, and optional Twilio for telephony.
STT_API_KEY=
LLM_API_KEY=
TTS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Calling
CALLER_NUMBER=+1XXXXXXXXXX
ASSESSMENT_NUMBER=+18054398008

# Optional runtime settings
ARTIFACT_DIR=artifacts
MAX_CALL_DURATION_SECONDS=240
